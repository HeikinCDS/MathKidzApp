<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/primary"
            android:textSize="42sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.03" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/main_subtitle"
            android:textColor="@color/text_dark"
            android:textSize="20sp"
            android:gravity="center"
            android:alpha="0.85" />

        <Button
            android:id="@+id/btnCounting"
            style="@style/HomeTopicButton"
            android:layout_marginTop="30dp"
            android:background="@drawable/button_counting"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="@string/topic_counting" />

        <Button
            android:id="@+id/btnPlaceValue"
            style="@style/HomeTopicButton"
            android:background="@drawable/button_place_value"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="@string/topic_place_value" />

        <Button
            android:id="@+id/btnNumberWords"
            style="@style/HomeTopicButton"
            android:background="@drawable/button_number_words"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="@string/topic_number_words" />

        <Button
            android:id="@+id/btnSequence"
            style="@style/HomeTopicButton"
            android:background="@drawable/button_sequence"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="@string/topic_sequence" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/home_card"
            android:elevation="2dp"
            android:padding="20dp"
            android:text="@string/main_footer"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>
</ScrollView>
